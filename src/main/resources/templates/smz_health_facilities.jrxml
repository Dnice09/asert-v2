		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="ASERT"/>
		<queryString language="SQL">
			<![CDATA[select f.name as "officialName", f.common_name as "commonName", f.hfr_code as code, l.name as level, t.name as type, fc.name as category, oa.name as ownership, f.latitude, f.longitude, sh.name as shehia, wd.name as ward, ds.name as district, rg.name as region, isl.name as island, string_agg(cah.name, ',') as catchment, ost.name as status from facilities f join admin_hierarchies sh on sh.id = f.admin_hierarchy_id join admin_hierarchies wd on wd.id = sh.parent_id join admin_hierarchies ds on ds.id = wd.parent_id join admin_hierarchies rg on rg.id = ds.parent_id join admin_hierarchies isl on isl.id = rg.parent_id join facility_levels l on f.facility_level_id = l.id join facility_types t on f.facility_type_id = t.id join facility_ownership_categories fc on f.facility_ownership_category_id = fc.id join facility_ownership_authorities oa on f.facility_ownership_authority_id = oa.id left join facility_operation_statuses ost on f.operating_status_id = ost.id left join facility_catchment_areas fca on f.id = fca.facility_id left join admin_hierarchies cah on cah.id = fca.admin_hierarchy_id where status = 'FACILITY_REGISTERED' group by f.name, f.common_name, f.hfr_code, l.name, t.name, fc.name, oa.name, f.latitude, f.longitude, sh.name, wd.name, ds.name, rg.name, isl.name, ost.name]]>
